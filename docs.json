{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Orchid",
  "colors": {
    "primary": "#89C4E1",
    "light": "#a8d4ea",
    "dark": "#5a9ab5"
  },
  "background": {
    "decoration": "gradient",
    "color": {
      "light": "#ffffff",
      "dark": "#0a0a0a"
    }
  },
  "styling": {
    "codeblocks": {
      "theme": {
        "light": "light-plus",
        "dark": "dark-plus"
      }
    }
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:hello@orchid.ac"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open the console",
      "href": "https://app.orchid.ac"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Developer API",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "index",
              "getting-started/quickstart",
              "getting-started/keys-and-scopes",
              "getting-started/concepts",
              "getting-started/deployments"
            ]
          },
          {
            "group": "Send",
            "pages": [
              "send/events",
              "send/event-types",
              "send/agents",
              "send/audit-record",
              "send/contents"
            ]
          },
          {
            "group": "Read",
            "pages": [
              "read/record",
              "read/metrics",
              "read/cost",
              "read/alerts"
            ]
          },
          {
            "group": "Act",
            "pages": [
              "act/webhooks",
              "act/alerts",
              "act/insight-actions",
              "act/agent-runs"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "reference/endpoints",
              "reference/event-kinds",
              "reference/errors"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Dashboard",
          "href": "https://app.orchid.ac",
          "icon": "gauge",
          "color": {
            "light": "#1d4ed8",
            "dark": "#93c5fd"
          }
        },
        {
          "anchor": "Support",
          "href": "mailto:hello@orchid.ac",
          "icon": "envelope",
          "color": {
            "light": "#64748b",
            "dark": "#a3d1ff"
          }
        }
      ]
    }
  },
  "redirects": [
    {
      "source": "/getting-started/authentication",
      "destination": "/getting-started/keys-and-scopes"
    },
    {
      "source": "/getting-started/models",
      "destination": "/"
    },
    {
      "source": "/guides/:slug*",
      "destination": "/"
    },
    {
      "source": "/integrations/:slug*",
      "destination": "/"
    },
    {
      "source": "/cli/:slug*",
      "destination": "/"
    },
    {
      "source": "/self-hosting/:slug*",
      "destination": "/getting-started/deployments"
    },
    {
      "source": "/api-reference/webhooks",
      "destination": "/act/webhooks"
    },
    {
      "source": "/api-reference/usage",
      "destination": "/read/cost"
    },
    {
      "source": "/api-reference/:slug*",
      "destination": "/reference/endpoints"
    }
  ],
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "cursor"
    ]
  },
  "footer": {
    "socials": {
      "linkedin": "https://uk.linkedin.com/company/orchidtechnologies"
    }
  }
}
